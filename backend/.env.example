PORT=3001

# OBBLIGATORIO — minimo 32 caratteri. Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opzionale — se impostato, serve per registrarsi
INVITE_CODE=

# URL di Ollama per il proxy AI
OLLAMA_URL=http://localhost:11434

# Origini CORS permesse (separate da virgola). Vuoto = qualsiasi origine.
# In produzione con Caddy/Nginx sullo stesso dominio, lasciare vuoto.
CORS_ORIGINS=
